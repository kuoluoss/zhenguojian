set(APP_DISPLAY_NAME "红果鉴")
set(APP_EXECUTABLE_NAME "hongguojian.exe")
foreach(ENTRY IN LISTS FLUTTER_TOOL_ENVIRONMENT)
  if(ENTRY MATCHES "^DART_DEFINES=(.*)$")
    string(REPLACE "," ";" APP_DART_DEFINES "${CMAKE_MATCH_1}")
    foreach(DEFINE IN LISTS APP_DART_DEFINES)
      # EDITION=all / EDITION=languo / EDITION=hongguo（Base64 编码后的 dart-define）
      if(DEFINE STREQUAL "RURJVElPTj1hbGw=")
        set(APP_DISPLAY_NAME "真果鉴")
        set(APP_EXECUTABLE_NAME "zhenguojian.exe")
      elseif(DEFINE STREQUAL "RURJVElPTj1sYW5ndW8=")
        set(APP_DISPLAY_NAME "蓝果鉴")
        set(APP_EXECUTABLE_NAME "languojian.exe")
      elseif(DEFINE STREQUAL "RURJVElPTj1ob25nZ3Vv")
        set(APP_DISPLAY_NAME "红果鉴")
        set(APP_EXECUTABLE_NAME "hongguojian.exe")
      elseif(DEFINE STREQUAL "QUxMX1NPVVJDRVM9dHJ1ZQ==")
        set(APP_DISPLAY_NAME "真果鉴")
        set(APP_EXECUTABLE_NAME "zhenguojian.exe")
      elseif(DEFINE STREQUAL "QUxMX1NPVVJDRVM9ZmFsc2U=")
        set(APP_DISPLAY_NAME "红果鉴")
        set(APP_EXECUTABLE_NAME "hongguojian.exe")
      endif()
    endforeach()
  endif()
endforeach()
